# ============================================================
# public/.htaccess — فلكس للدعاية والإعلان
# يُستخدم عندما يكون جذر الموقع هو مجلد public/
# أو عند الوصول عبر /public/ على cPanel
# ============================================================

Options -Indexes
RewriteEngine On

# ── تحديد الـ base path تلقائياً (/ أو /public/) ──────────
RewriteBase /

# ── الملفات الثابتة تُقدَّم مباشرةً ───────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── الروابط النظيفة → PHP مباشرةً ─────────────────────────
RewriteRule ^portfolio/?$  portfolio.php  [L,QSA]
RewriteRule ^gallery/?$    gallery.php    [L,QSA]
RewriteRule ^services/?$   services.php  [L,QSA]
RewriteRule ^about/?$      about.php     [L,QSA]
RewriteRule ^contact/?$    contact.php   [L,QSA]

# ── ضغط gzip ────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Cache للأصول ────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg       "access plus 30 days"
    ExpiresByType image/png        "access plus 30 days"
    ExpiresByType image/webp       "access plus 30 days"
    ExpiresByType font/woff2       "access plus 1 year"
    ExpiresByType text/css         "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# ── حماية ملفات حساسة ────────────────────────────────────────
<FilesMatch "\.(sql|log|env|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
